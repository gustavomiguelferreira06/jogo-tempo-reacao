  {"id":"jr_inj","type":"inject","z":"jr_tab","name":"Ao fazer Deploy","props":[{"p":"payload"}],"repeat":"","crontab":"","once":true,"onceDelay":"0.5","topic":"","payload":"","payloadType":"date","x":150,"y":60,"wires":[["jr_sq_create"]]},
  {"id":"jr_sq_create","type":"sqlite","z":"jr_tab","mydb":"jr_db","sqlquery":"fixed","sql":"CREATE TABLE IF NOT EXISTS partidas (\n  id        INTEGER PRIMARY KEY AUTOINCREMENT,\n  jogador   TEXT NOT NULL,\n  tempo_ms  INTEGER,\n  modo      TEXT,\n  queimou   INTEGER DEFAULT 0,\n  data_hora TEXT DEFAULT (datetime('now','localtime'))\n);","name":"Cria tabela","x":360,"y":60,"wires":[["jr_sq_rank","jr_sq_stats"]]},
  {"id":"jr_mqtt_res","type":"mqtt in","z":"jr_tab","name":"Resultado do ESP32","topic":"utfpr/reacao/grupo1/resultado","qos":"0","datatype":"json","broker":"jr_broker","nl":false,"rap":true,"rh":0,"inputs":0,"x":150,"y":180,"wires":[["jr_f_insert","jr_f_ultimo","jr_f_grafico","jr_debug"]]},
  {"id":"jr_f_insert","type":"function","z":"jr_tab","name":"Prepara INSERT","func":"const r = msg.payload;\nmsg.params = {\n  $jogador: r.jogador,\n  $tempo:   r.queimou ? null : r.tempo_ms,\n  $modo:    r.modo,\n  $queimou: r.queimou ? 1 : 0\n};\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":400,"y":140,"wires":[["jr_sq_insert"]]},
  {"id":"jr_sq_insert","type":"sqlite","z":"jr_tab","mydb":"jr_db","sqlquery":"prepared","sql":"INSERT INTO partidas (jogador, tempo_ms, modo, queimou)\nVALUES ($jogador, $tempo, $modo, $queimou);","name":"Grava partida","x":620,"y":140,"wires":[["jr_sq_rank","jr_sq_stats"]]},
  {"id":"jr_f_ultimo","type":"function","z":"jr_tab","name":"Ultimo tempo","func":"const r = msg.payload;\nmsg.payload = r.queimou\n  ? `${r.jogador}: queima de largada!`\n  : `${r.jogador}: ${r.tempo_ms} ms`;\nreturn msg;","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":400,"y":200,"wires":[["jr_ui_ultimo"]]},
  {"id":"jr_f_grafico","type":"function","z":"jr_tab","name":"Ponto do grafico","func":"const r = msg.payload;\nif (r.queimou) return null;   // queima nao entra no grafico\nreturn { topic: r.jogador, payload: r.tempo_ms };","outputs":1,"timeout":0,"noerr":0,"initialize":"","finalize":"","libs":[],"x":410,"y":260,"wires":[["jr_ui_chart"]]},
  {"id":"jr_debug","type":"debug","z":"jr_tab","name":"Resultados recebidos","active":true,"tosidebar":true,"console":false,"tostatus":false,"complete":"payload","targetType":"msg","statusVal":"","statusType":"auto","x":420,"y":320,"wires":[]},
  {"id":"jr_sq_rank","type":"sqlite","z":"jr_tab","mydb":"jr_db","sqlquery":"fixed","sql":"SELECT jogador AS Jogador,\n       MIN(tempo_ms) AS Recorde_ms,\n       ROUND(AVG(tempo_ms)) AS Media_ms,\n       COUNT(*) AS Rodadas\nFROM partidas\nWHERE queimou = 0\nGROUP BY jogador\nORDER BY Recorde_ms\nLIMIT 10;","name":"Ranking top 10","x":880,"y":100,"wires":[["jr_ui_rank"]]},
  {"id":"jr_sq_stats","type":"sqlite","z":"jr_tab","mydb":"jr_db","sqlquery":"fixed","sql":"SELECT COUNT(*) AS Rodadas,\n       MIN(tempo_ms) AS Recorde_ms,\n       ROUND(AVG(tempo_ms)) AS Media_ms,\n       IFNULL(SUM(queimou), 0) AS Queimas\nFROM partidas;","name":"Estatisticas","x":870,"y":160,"wires":[["jr_ui_stats"]]},
